# Application
PROJECT_NAME=实验室设备助手
ENV=development
LOG_LEVEL=INFO
DEBUG=True

# Storage
DATABASE_URL=sqlite:///data/lab_device_assistant.sqlite3
DOCUMENT_STORAGE_PATH=data/uploads
DOCUMENT_CONTEXT_MAX_CHARS=60000
DOCUMENT_UPLOAD_MAX_BYTES=26214400

# OpenAI-compatible chat service
OPENAI_API_KEY=replace-with-your-key
OPENAI_API_BASE=https://api.openai.com/v1
CHAT_MODEL_NAME=gpt-4o-mini

# Authentication
SECRET_KEY=replace-with-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional provider settings used by local ingestion scripts
DASHSCOPE_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=
