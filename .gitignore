# Local environment and secrets
.env
.env.*
!.env.example

# OS and editor files
.DS_Store
.idea/
.vscode/*.local.json
.claude/settings.local.json

# Python caches and local build metadata
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend dependencies and generated bundles
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Runtime data and generated ingestion output
data/*.sqlite3
data/archive/
data/uploads/
data/gemini-output/

# Generic temporary files
*.log
*.tmp

# Empty lockfile generated at repository root (frontend has its own lockfile)
/package-lock.json
